    extends State<DetailsPage> {

  @override
  Widget build(BuildContext context) {

    Item item =
        widget.item;

    return Scaffold(

      appBar: AppBar(
        title:
        Text('Item Details'),
      ),

      body: Padding(
        padding:
        EdgeInsets.all(20),

        child: Column(
          crossAxisAlignment:
          CrossAxisAlignment.start,

          children: [

            Center(
              child: Icon(
                item.type == 'Lost'
                    ? Icons.search_off
                    : Icons.check_circle,

                size: 70,

                color:
                Colors.indigo,
              ),
            ),

            SizedBox(height: 20),

            Center(
              child: Text(
                item.name,

                style:
                TextStyle(
                  fontSize: 25,
                  fontWeight:
                  FontWeight.bold,
                ),
              ),
            ),

            SizedBox(height: 20),

            Text(
              'Category: ${item.category}',
            ),

            SizedBox(height: 8),

            Text(
              'Location: ${item.location}',
            ),

            SizedBox(height: 8),

            Text(
              'Date: ${item.date}',
            ),

            SizedBox(height: 8),

            Text(
              'Type: ${item.type}',
            ),

            SizedBox(height: 15),

            Text(
              'Description',
              style:
              TextStyle(
                fontSize: 18,
                fontWeight:
                FontWeight.bold,
              ),
            ),

            SizedBox(height: 5),

            Text(
              item.description,
            ),

            SizedBox(height: 25),

            // Found button
            if (!item.found)

              SizedBox(
                width:
                double.infinity,

                child:
                ElevatedButton.icon(

                  onPressed: () {

                    setState(() {

                      item.found =
                      true;

                      item.type =
                      'Found';
                    });

                    widget.refresh();

                    ScaffoldMessenger
                        .of(context)
                        .showSnackBar(
                      SnackBar(
                        content:
                        Text(
                          'Item marked as Found',
                        ),
                      ),
                    );
                  },

                  icon:
                  Icon(Icons.check),

                  label:
                  Text(
                    'Mark as Found',
                  ),
                ),
              ),

            if (item.found)

              Container(
                width:
                double.infinity,

                padding:
                EdgeInsets.all(15),

                decoration:
                BoxDecoration(
                  color:
                  Colors.green.shade100,

                  borderRadius:
                  BorderRadius.circular(12),
                ),

                child:
                Center(
                  child: Text(
                    'This item is Found',

                    style:
                    TextStyle(
                      color:
                      Colors.green,

                      fontWeight:
                      FontWeight.bold,
                    ),
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}      
